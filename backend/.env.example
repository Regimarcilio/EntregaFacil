# ===========================================
# EntregaFácil Backend - Environment Variables
# ===========================================
# Copy to .env and fill in real values
# NEVER commit .env with real values!

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ===========================================
# Database (PostgreSQL + PostGIS)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/entregafacil?schema=public
DATABASE_POOL_SIZE=20

# ===========================================
# Redis (Cache + Rate Limiting + Sessions)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Authentication (JWT)
# ===========================================
# MUST be at least 32 characters for HS256
# Generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-for-hs256
JWT_ISSUER=entregafacil
JWT_AUDIENCE=entregafacil-mobile

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
# REQUIRED in production!
CORS_ORIGIN=https://entregafacil.app,https://app.entregafacil.app,exp://entregafacil.app

# ===========================================
# MinIO / S3 Compatible Storage
# ===========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=entregafacil
MINIO_PUBLIC_URL=https://minio.entregafacil.app

# ===========================================
# Evolution API (WhatsApp)
# ===========================================
EVOLUTION_BASE_URL=https://evolution.entregafacil.app
EVOLUTION_WEBHOOK_SECRET=your-webhook-secret-generate-with-openssl-rand-base64-32
EVOLUTION_API_KEY=your-evolution-api-key

# ===========================================
# OSRM (Routing)
# ===========================================
OSRM_BASE_URL=http://localhost:5000

# ===========================================
# GraphHopper (VRP Fallback)
# ===========================================
GRAPHHOPPER_BASE_URL=http://localhost:8989
GRAPHHOPPER_API_KEY=

# ===========================================
# Nominatim (Geocoding)
# ===========================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=your-email@entregafacil.app

# ===========================================
# Push Notifications (Expo)
# ===========================================
EXPO_PROJECT_ID=your-expo-project-id
EXPO_ACCESS_TOKEN=your-expo-access-token

# ===========================================
# Sentry (Error Tracking)
# ===========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
SENTRY_ORG=entregafacil
SENTRY_PROJECT=backend

# ===========================================
# Feature Flags
# ===========================================
ENABLE_VRP_FALLBACK=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_SYNC=true

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_SYNC_MAX=30
RATE_LIMIT_SYNC_WINDOW_MS=60000