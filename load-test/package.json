{
  "name": "entregafacil-load-test",
  "version": "1.0.0",
  "description": "k6 load tests for EntregaFácil API",
  "scripts": {
    "test": "k6 run k6-script.js",
    "test:staging": "API_URL=https://api-staging.entregafacil.app k6 run k6-script.js",
    "test:prod": "API_URL=https://api.entregafacil.app k6 run k6-script.js",
    "test:smoke": "k6 run --vus 1 --duration 30s k6-script.js",
    "test:stress": "k6 run --vus 200 --duration 10m k6-script.js",
    "test:soak": "k6 run --vus 50 --duration 1h k6-script.js"
  },
  "devDependencies": {
    "k6": "^0.47.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}