# ===========================================
# EntregaFácil Staging Environment
# ===========================================
# Copy to .env.staging and fill in REAL values
# NEVER commit this file with real values!
# Use: cp .env.staging.template .env.staging

# ===========================================
# Application
# ===========================================
NODE_ENV=staging
LOG_LEVEL=debug

# ===========================================
# Database (PostgreSQL + PostGIS)
# ===========================================
POSTGRES_USER=entregafacil_staging
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_32_CHARS_MIN
POSTGRES_DB=entregafacil_staging

# ===========================================
# Redis
# ===========================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===========================================
# MinIO / S3 Storage
# ===========================================
MINIO_ACCESS_KEY=minioadmin_staging
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# ===========================================
# Authentication (JWT)
# ===========================================
# MUST be at least 32 characters for HS256
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS_FOR_HS256
JWT_ISSUER=entregafacil
JWT_AUDIENCE=entregafacil-mobile

# ===========================================
# CORS - REQUIRED for staging
# ===========================================
CORS_ORIGIN=https://staging.entregafacil.app,exp://staging.entregafacil.app

# ===========================================
# MinIO / S3 Storage
# ===========================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=entregafacil
MINIO_PUBLIC_URL=https://minio-staging.entregafacil.app

# ===========================================
# OSRM (Routing)
# ===========================================
OSRM_BASE_URL=http://osrm:5000

# ===========================================
# GraphHopper (VRP Fallback)
# ===========================================
GRAPHHOPPER_BASE_URL=http://graphhopper:8989

# ===========================================
# Evolution API (WhatsApp)
# ===========================================
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET_32_CHARS

# ===========================================
# Nominatim (Geocoding)
# ===========================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=staging@entregafacil.app

# ===========================================
# Sentry (Error Tracking)
# ===========================================
SENTRY_DSN=https://your-staging-dsn@sentry.io/project
SENTRY_ORG=entregafacil
SENTRY_PROJECT=backend-staging

# ===========================================
# Feature Flags
# ===========================================
ENABLE_VRP_FALLBACK=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_SYNC=true

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_SYNC_MAX=30
RATE_LIMIT_SYNC_WINDOW_MS=60000