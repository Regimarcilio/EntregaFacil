# EntregaFácil Mobile - Environment Variables
# Copy to .env.local for local development
# DO NOT COMMIT THIS FILE WITH REAL VALUES

# ===========================================
# API Configuration
# ===========================================
EXPO_PUBLIC_API_URL=https://api-dev.entregafacil.app
EXPO_PUBLIC_EVOLUTION_URL=https://evolution-dev.entregafacil.app

# ===========================================
# Map Configuration
# ===========================================
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# ===========================================
# EAS / Expo
# ===========================================
EAS_PROJECT_ID=your_eas_project_id
EXPO_TOKEN=your_expo_token

# ===========================================
# Sentry (Error Tracking)
# ===========================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=entregafacil
SENTRY_PROJECT=mobile

# ===========================================
# Code Signing (Expo Updates)
# ===========================================
EXPO_UPDATES_CODE_SIGNING_CERT=your_base64_encoded_certificate

# ===========================================
# Google Play / Apple (for local builds)
# ===========================================
# Android
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEY_PASSWORD=your_key_password

# iOS
APPLE_ID=your_apple_id
APPLE_TEAM_ID=your_team_id
ASC_APP_ID=your_app_store_connect_app_id
APP_STORE_CONNECT_API_KEY=base64_encoded_api_key

# ===========================================
# Build Configuration
# ===========================================
NODE_ENV=development
EAS_BUILD_PROFILE=development
APP_VERSION=0.1.0-dev
BUILD_NUMBER=1

# ===========================================
# MinIO / Storage
# ===========================================
EXPO_PUBLIC_MINIO_PUBLIC_URL=https://minio.entregafacil.app

# ===========================================
# Feature Flags
# ===========================================
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASHLYTICS=false
EXPO_PUBLIC_DEBUG_MODE=true